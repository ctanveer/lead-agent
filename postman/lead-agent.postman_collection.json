{
  "info": {
    "name": "Lead Agent",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Test requests for POST /leads. Set leadApiKey to the LEAD_API_KEY value in .env."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "leadApiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Hot lead (VP, demo request)",
      "request": {
        "method": "POST",
        "description": "Expect 202 {\"status\":\"accepted\"}.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{leadApiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amina Rahman\",\n  \"email\": \"amina@acmelogistics.com\",\n  \"company\": \"Acme Logistics\",\n  \"job_title\": \"VP Operations\",\n  \"message\": \"We need a demo for 40 users.\",\n  \"source\": \"demo_form\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/leads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "leads"
          ]
        }
      }
    },
    {
      "name": "Wrong API key (expect 401)",
      "request": {
        "method": "POST",
        "description": "",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "wrong-key"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amina Rahman\",\n  \"email\": \"amina@acmelogistics.com\",\n  \"company\": \"Acme Logistics\",\n  \"job_title\": \"VP Operations\",\n  \"message\": \"We need a demo for 40 users.\",\n  \"source\": \"demo_form\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/leads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "leads"
          ]
        }
      }
    },
    {
      "name": "Intern, newsletter (expect cold/warm)",
      "request": {
        "method": "POST",
        "description": "",
